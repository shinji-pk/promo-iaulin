# Não há credenciais necessárias em arquivo para o uso cotidiano.
# A configuração é feita pelo painel. Opção técnica de porta:
PROMOBRIDGE_PORT=3030

# Somente para hospedar o backend de contas; segredos no ambiente do servidor.
# BETTER_AUTH_URL=https://seu-dominio
# BETTER_AUTH_SECRET=gere-um-segredo-de-pelo-menos-32-caracteres
# BLOB_STORE_ID=store_...
# BLOB_READ_WRITE_TOKEN=configurado-pela-integracao-privada

# Recuperação de senha e alteração de e-mail (Resend; exclusivamente no servidor):
# RESEND_API_KEY=configure-este-segredo-criptografado-no-vercel
# Escolha UMA das opções abaixo, só DEPOIS que o domínio constar "Verified" no Resend:
# TRANSACTIONAL_EMAIL_DOMAIN=dominio-verificado.com
#   -> o app envia como "Promo IAulin <promo@dominio-verificado.com>".
# Alternativa legada / override (prioritária):
# RESEND_FROM_EMAIL=Promo IAulin <contas@dominio-verificado.com>
# Deixe as duas opções de remetente vazias enquanto aguarda o domínio:
# "Esqueci minha senha" permanecerá desabilitado, evitando promessas falsas.
