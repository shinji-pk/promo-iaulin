# Não há credenciais necessárias em arquivo para o uso cotidiano.
# A configuração é feita pelo painel. Opção técnica de porta:
PROMOBRIDGE_PORT=3030

# Somente para hospedar o backend de contas; segredos no ambiente do servidor.
# BETTER_AUTH_URL=https://seu-dominio
# BETTER_AUTH_SECRET=gere-um-segredo-de-pelo-menos-32-caracteres
# BLOB_STORE_ID=store_...
# BLOB_READ_WRITE_TOKEN=configurado-pela-integracao-privada

# Recuperação de senha e alteração de e-mail (remetente Resend verificado):
# RESEND_API_KEY=configure-este-segredo-no-vercel
# RESEND_FROM_EMAIL=Promo IAulin <contas@seu-dominio-verificado.com>
